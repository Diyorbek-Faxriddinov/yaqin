# Namuna fayl. Nusxa oling: .env — va qiymatlarni o'zingizniki bilan almashtiring.
# Haqiqiy kalitlar va parollar hech qachon Git'ga qo'shilmaydi.

# Ishlab chiqishda true; productionda albatta false
DJANGO_DEBUG=true
# Productionda majburiy: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL + PostGIS
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=yaqin
DATABASE_USER=yaqin
DATABASE_PASSWORD=

# Faqat Windows'da (GeoDjango uchun): PostGIS toʻplamidagi DLL'lar. Linux'da kerak emas.
# GDAL_LIBRARY_PATH=D:/tools/pgsql/bin/libgdal-35.dll
# GEOS_LIBRARY_PATH=D:/tools/pgsql/bin/libgeos_c.dll

# Mijoz kirishi. Bo'sh qoldirilsa — tegishli usul o'chiq (halol 401 provider_unavailable)
# TELEGRAM_BOT_TOKEN=
# GOOGLE_CLIENT_ID=
# Demo kirish — faqat DEBUG rejimida (standart: DEBUG bilan bir xil)
# DEMO_LOGIN_ENABLED=true

# Admin 2FA (TOTP) kalitlarini shifrlash — productionda majburiy. Yaratish:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Kalit yo'qolsa, barcha administratorlar 2FA ni qaytadan sozlashi kerak bo'ladi.
# TOTP_ENCRYPTION_KEY=

# Frontend keshini yangilash webhook'i (frontenddagi REVALIDATE_SECRET bilan bir xil)
# FRONTEND_REVALIDATE_URL=http://localhost:3000/api/revalidate
# REVALIDATE_SECRET=

# Faqat DEBUG va E2E: cheklovlarni yumshatish (barcha testlar bitta IP'dan)
# DJANGO_THROTTLE_OVERRIDES=auth=1000/min,business_requests=1000/hour

# Productionda kesh (cheklov va bloklash hisoblagichlari barcha jarayonlar uchun umumiy)
# REDIS_URL=redis://localhost:6379/0

# O'zgartiruvchi API so'rovlari faqat shu saytlardan (vergul bilan; standart — lokal frontend)
# DJANGO_ALLOWED_ORIGINS=https://yaqin.uz

# HTTPS (productionda, reverse proxy ortida). HSTS — HTTPS to'liq ishlashi tasdiqlangandan keyin
# DJANGO_BEHIND_HTTPS_PROXY=true
# DJANGO_SSL_REDIRECT=true
# DJANGO_HSTS_SECONDS=31536000
# DJANGO_HSTS_INCLUDE_SUBDOMAINS=true
# DJANGO_HSTS_PRELOAD=true

# Reverse proxy ortida: nechta proksi X-Forwarded-For ga yozadi (IP cheklovlari uchun)
# DJANGO_NUM_PROXIES=1
