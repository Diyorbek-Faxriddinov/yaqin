# Namuna fayl. Nusxa oling: .env — va qiymatlarni o'zingizniki bilan almashtiring.
# Haqiqiy kalitlar va parollar hech qachon Git'ga qo'shilmaydi.

# Ishlab chiqishda true; productionda albatta false
DJANGO_DEBUG=true
# Productionda majburiy: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL + PostGIS
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=yaqin
DATABASE_USER=yaqin
DATABASE_PASSWORD=

# Faqat Windows'da (GeoDjango uchun): PostGIS toʻplamidagi DLL'lar. Linux'da kerak emas.
# GDAL_LIBRARY_PATH=D:/tools/pgsql/bin/libgdal-35.dll
# GEOS_LIBRARY_PATH=D:/tools/pgsql/bin/libgeos_c.dll
