# Namuna fayl. Nusxa oling: .env.local — va qiymatlarni o'zingizniki bilan almashtiring.
# Haqiqiy kalitlar hech qachon Git'ga qo'shilmaydi.

# Saytning ommaviy manzili (canonical, sitemap, OG uchun)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Backend API manzili (server tomoni). Faqat demo rejim o'chirilganda kerak.
# Brauzer so'rovlari doim /api/v1 orqali ketadi (productionda reverse proxy backendga yo'naltiradi).
# API_URL=http://localhost:8000/api/v1

# "false" bo'lmasa — demo rejim: mock maʼlumotlar va "Demo rejim" ogohlantirishi (ADR-0011)
NEXT_PUBLIC_DEMO_MODE=true

# Haqiqiy backend bilan ham "Demo foydalanuvchi" tugmasi — faqat ishlab chiqish va E2E
# NEXT_PUBLIC_DEMO_LOGIN=true

# Xarita uslubi (ixtiyoriy). Standart — OpenFreeMap (bepul, kalitsiz)
# NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# Backend kesh yangilash webhook'i uchun maxfiy kalit (POST /api/revalidate). Bo'sh — o'chiq.
# REVALIDATE_SECRET=
