# Production muhiti — namuna. Serverda nusxa oling: `cp env.example .env` va to'ldiring.
# .env Git'ga kirmaydi (.gitignore). Maxfiy qiymatlarni serverning o'zida yarating, chatga yoki
# boshqa joyga yozmang; nusxasi — faqat parol menejeringizda.
#
# Maxfiy qiymat yaratish (serverda):
#   openssl rand -base64 48 | tr -d '/+=\n' | cut -c1-50; echo
# TOTP kaliti (Fernet):
#   docker compose run --rm --no-deps backend python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

# --- Sayt manzili ---
SITE_DOMAIN=yaqinapp.uz
SITE_URL=https://yaqinapp.uz
# Caddy sayt manzillari (www → asosiy domenga yo'naltiriladi)
SITE_ADDRESS=yaqinapp.uz, www.yaqinapp.uz
# Qidiruv tizimlari: "open" bo'lmaguncha yopiq (noindex). Ochish — 5.6, egasining qarori bilan
SITE_INDEXING=closed

# --- Maxfiy (har biri alohida, uzun, tasodifiy) ---
POSTGRES_PASSWORD=
DATABASE_PASSWORD=
DJANGO_SECRET_KEY=
# ⚠ Yo'qolsa, barcha administratorlar 2FA ni qaytadan sozlaydi — zaxira nusxasini saqlang
TOTP_ENCRYPTION_KEY=
REVALIDATE_SECRET=

# --- Mijoz kirishi (docs/auth-setup.md). Bo'sh — tegishli usul o'chiq ---
TELEGRAM_BOT_TOKEN=
GOOGLE_CLIENT_ID=

# --- Zaxira (deploy/backup, restic → Servercore S3 Toshkent). Kiritish: deploy/set-secret.sh ---
# s3:https://<endpoint>/<bucket>/yaqin
BACKUP_REPOSITORY=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_S3_REGION=
# Zaxira shifrlash paroli — backup/install.sh yaratadi.
# ⚠ Yo'qolsa, zaxiralarni ochib bo'lmaydi — parol menejerida saqlang
BACKUP_PASSWORD=
# Ogohlantirishlar: administratorning Telegram chat ID'si (botga /start yozgandan keyin)
ALERT_TELEGRAM_CHAT_ID=

# --- Image'lar: Release workflow'i yig'adi, ./deploy.sh <commit> o'zi yozadi ---
# BACKEND_IMAGE=ghcr.io/diyorbek-faxriddinov/yaqin-backend:<commit>
# FRONTEND_IMAGE=ghcr.io/diyorbek-faxriddinov/yaqin-frontend:<commit>
